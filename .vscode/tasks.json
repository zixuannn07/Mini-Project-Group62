{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build E-Waste Project",
            "type": "shell",
            "command": "g++",
            "args": [
                "-g",
                "-std=c++11",
                "-Wall",
                "-Wextra",
                "${workspaceFolder}/main.cpp",
                "${workspaceFolder}/fileHandling.cpp",
                "${workspaceFolder}/inputAndMenu.cpp",
                "${workspaceFolder}/recycling.cpp",
                "${workspaceFolder}/recordManagement.cpp",
                "${workspaceFolder}/weightCalculation.cpp",
                "${workspaceFolder}/program.cpp",
                "-o",
                "${workspaceFolder}/ewaste.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
